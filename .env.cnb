# ============================================================
# 影策 CNB 镜像部署配置（2G 小内存服务器版）
#
# 用法：
#   1. 把本文件和仓库里的 docker-compose.deploy.yml 一起下载到服务器
#      同一个文件夹，例如 /opt/open-ai-canvas/
#   2. 打开本文件，把下面 3 处【改成你自己的】替换掉（全文替换一次即可）
#   3. 在服务器终端执行（先登录 CNB 制品库再启动）：
#        cd /opt/open-ai-canvas
#        docker login docker.cnb.cool -u cnb -p 你的CNB访问令牌
#        docker compose --env-file .env.cnb -f docker-compose.deploy.yml up -d
# ============================================================

# ↓ 数据库密码：改成你自己的（一长串英文数字，越乱越好）
POSTGRES_PASSWORD=改成你自己的数据库密码

POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
# ↓ 注意：这里要和上面改成同一个密码！
DATABASE_URL=postgresql://open_ai_canvas:改成你自己的数据库密码@postgres:5432/open_ai_canvas?sslmode=disable

# 对外端口（宝塔和云安全组也要放行 3000）
CANVAS_HTTP_PORT=3000

# CNB 制品库镜像（本次构建标签；升级构建后改成新标签）
CANVAS_BACKEND_IMAGE=docker.cnb.cool/cloudcvm/visionaryai/backend:1f9aabc3
CANVAS_WEB_IMAGE=docker.cnb.cool/cloudcvm/visionaryai/web:1f9aabc3
CANVAS_YINGCE_AGENT_IMAGE=docker.cnb.cool/cloudcvm/visionaryai/agent:1f9aabc3

# ↓ Agent 密钥：也改成你自己的随机长字符串
YINGCE_AGENT_TOKEN=改成你自己的随机密钥

# 允许注册（个人使用保持 true；给多人公开部署时改成 false）
CANVAS_REGISTRATION_ENABLED=true

# ── 2G 内存机器专用：压低各容器内存上限，防止把机器撑爆 ──
YINGCE_AGENT_MEMORY_LIMIT=320m
YINGCE_AGENT_NODE_MEMORY_MB=200
YINGCE_AGENT_TMPFS_SIZE=64m
YINGCE_AGENT_SESSION_CAP=4
YINGCE_AGENT_MAX_SESSIONS=4
CANVAS_BACKEND_MEMORY_LIMIT=512m
CANVAS_BACKEND_CPUS=1
CANVAS_WORKER_CONCURRENCY=2
CANVAS_CHANNEL_CONCURRENCY=2
